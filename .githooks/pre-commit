#!/bin/sh
# Reject Unicode em dashes introduced by staged text changes.
set -eu

forbidden=$(printf '\342\200\224')
patch=$(git diff --cached --no-ext-diff --no-textconv --no-color --find-renames --unified=0) || exit 1

printf '%s\n' "$patch" | LC_ALL=C awk -v forbidden="$forbidden" '
    /^diff --git / { in_hunk = 0; file = $0 }
    /^@@ / { in_hunk = 1 }
    in_hunk && /^\+/ && index($0, forbidden) {
        if (!found) {
            print "Commit rejected: Unicode em dash characters are not allowed."
            print "Use a regular hyphen-minus (-) or rewrite the sentence:"
        }
        print file
        print $0
        found = 1
    }
    END { exit found ? 1 : 0 }
' >&2
