    "scroll.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverse mouse scrolling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odwróć przewijanie myszy"
          }
        }
      }
    },
    "scroll.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverses the mouse wheel in both directions. Trackpad gestures keep their system direction. Requires Accessibility and Input Monitoring access when enabled."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odwraca kółko myszy w obu osiach. Gesty gładzika zachowują kierunek systemowy. Włączenie wymaga Dostępności i Monitorowania wprowadzania."
          }
        }
      }
    },
    "scroll.compatibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically distinguishes mice and trackpads. If another app reverses scrolling, turn that feature off there."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie rozróżnia mysz i gładzik. Jeśli inna aplikacja odwraca przewijanie, wyłącz w niej tę funkcję."
          }
        }
      }
    },
