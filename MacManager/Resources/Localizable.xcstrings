      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking up a public address requires an external service. That service can see the source IP of the request."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzenie publicznego adresu wymaga połączenia z zewnętrzną usługą. Usługa widzi źródłowy adres IP zapytania."
          }
        }
      }
    },
    "network.notAvailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address lookup is not active in this version. No lookup requests are sent."
