    "network.vpn.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnel interfaces may also belong to system services. Their presence does not prove a VPN or a separate public address. The public result applies to this app and destination only."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfejsy tuneli mogą należeć także do usług systemowych. Ich obecność nie dowodzi działania VPN ani osobnego adresu publicznego. Wynik publiczny dotyczy tylko tej aplikacji i celu połączenia."
          }
        }
      }
    },
