{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "pl",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/MacManagerCore",
    },
  ],
  "files": [
    { "kind": "folder", "path": "MacManager", "target-membership": [ "MacManager", "MacManagerTests" ] },
    { "kind": "folder", "path": "MacManagerTests", "target-membership": [ "MacManagerTests" ] },
    { "kind": "folder", "path": "MacManagerUITests", "target-membership": [ "MacManagerUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MacManager.app", "id": "A00000000000000000000006", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MacManagerTests.xctest", "id": "A00000000000000000000008", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/MacManagerUITests.xctest", "id": "A00000000000000000000007", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "MacManagerTests",
      "id": "A00000000000000000000012",
      "product": "Products/MacManagerTests.xctest",
      "product-type": "bundle.unit-test",
      "build-phases": [ "compile-sources", "frameworks", "resources" ],
      "package-product-members": [
        { "product-name": "MacManagerCore", "build-phase": { "build-phase": "frameworks" } },
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.macmanager.MacManager.Tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) MM_UNIT_TESTS",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
      },
    },
    {
      "name": "MacManager",
      "id": "A00000000000000000000010",
      "product": "Products/MacManager.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "MacManagerCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "MacManager/MacManager.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "15",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Mac Manager Dev",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Mac Manager controls playback and reads the current track in Apple Music when you connect it.",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "0.8.11",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.macmanager.MacManager.Development",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
      },
    }, {
      "name": "MacManagerUITests",
      "id": "A00000000000000000000011",
      "product": "Products/MacManagerUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "MacManager",
      "dependencies": [
        "MacManager",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "CURRENT_PROJECT_VERSION": "15",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MARKETING_VERSION": "0.8.11",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.macmanager.MacManager.UITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TEST_TARGET_NAME": "MacManager",
      },
    },
  ],
  "build-settings": {
    "ARCHS": "arm64",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_STRICT_CONCURRENCY": "complete",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "26.6",
  "last-swift-update": "26.6",
}
